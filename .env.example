# Copy to .env and adjust. Never commit the resulting .env file.

# --- Application ---
APP_ENV=local
LOG_LEVEL=INFO

# --- PostgreSQL ---
# Credentials used by the Docker Compose `db` service.
POSTGRES_USER=equity
POSTGRES_PASSWORD=equity
POSTGRES_DB=equity_metrics
# Host-side URL. Inside Docker Compose the host is `db` instead of `localhost`.
DATABASE_URL=postgresql+psycopg://equity:equity@localhost:5432/equity_metrics

# --- LLM provider (via the internal ai_gateway module) ---
# `mock` needs no credentials and is the default for local work and all tests.
# `anthropic` needs LLM_API_KEY and `pip install anthropic`.
LLM_PROVIDER=mock
LLM_MODEL=mock-model
LLM_API_KEY=
# Per-provider-call timeout; the whole answer has its own larger budget.
LLM_TIMEOUT_SECONDS=30
LLM_TOTAL_TIMEOUT_SECONDS=90
LLM_MAX_TOOL_ITERATIONS=6
# Retries apply to transient provider faults only.
LLM_MAX_RETRIES=2

# Import the sample CSV when the api container starts. The importer is
# idempotent, so this is safe on every restart.
IMPORT_ON_START=true

# --- Web ---
CORS_ALLOW_ORIGINS=http://localhost:5173
